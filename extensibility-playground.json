{
  "name": "Extensibility Playground",
  "description": "The Shaleio logo flying through data-node obstacles, hosted entirely inside an existing StrataBI raw_html tile. No new backend, container, or infrastructure.",
  "version": "1.0.0",
  "settings": {
    "interval_enabled": false
  },
  "layout": [
    {
      "id": "why",
      "position": {
        "row": 0,
        "order": 0,
        "width": 12
      },
      "title": "Why is there a game in an analytics platform?",
      "block": {
        "type": "markdown",
        "config": {
          "content": "**The game is not the point.** StrataBI is built on *Dashboards as Code* and a documented, extensible module contract. This entire app is just:\n\n- **HTML, CSS, and JavaScript** running inside an existing dashboard tile\n- **No new container, no infrastructure, no redeployment** \u2014 it uses the renderer the platform already has\n- **Swappable for anything** \u2014 a custom visualization, a live simulation, an operational tool, a specialized business UI\n- **AI can write the app; StrataBI gives it a place to run**"
        }
      }
    },
    {
      "id": "game",
      "position": {
        "row": 1,
        "order": 0,
        "width": 12
      },
      "title": "Flappy Data",
      "block": {
        "type": "raw_html",
        "config": {
          "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n<title>Flappy Data</title>\n<style>\n  :root{\n    --bg0:#0b1016; --bg1:#0e1620; --ink:#eaf2f6; --mut:#9fb0bd;\n    --teal:#34b6c4; --cyan:#5fe0ef; --teal-dim:#1c6f7a; --edge:rgba(95,224,239,.55);\n    --danger:#db554a; --panel:rgba(10,16,22,.72);\n  }\n  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}\n  html,body{margin:0;height:100%;background:var(--bg0);color:var(--ink);\n    font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;overflow:hidden;}\n  #wrap{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;}\n  /* The playfield keeps a pleasant proportion and is centered; it never stretches full-width on desktop. */\n  #stage{position:relative;width:100%;height:100%;max-width:560px;margin:0 auto;\n    background:radial-gradient(130% 90% at 50% 0%,#101b26 0%,var(--bg1) 45%,var(--bg0) 100%);\n    box-shadow:0 0 0 1px rgba(95,224,239,.08), 0 30px 80px rgba(0,0,0,.45);overflow:hidden;touch-action:none;}\n  canvas{display:block;width:100%;height:100%;}\n  .overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;\n    justify-content:center;text-align:center;padding:24px;gap:14px;\n    background:linear-gradient(180deg,rgba(8,12,17,.35),rgba(8,12,17,.72));\n    backdrop-filter:blur(2px);}\n  .overlay.hide{display:none;}\n  .kicker{letter-spacing:.32em;font-size:12px;color:var(--cyan);text-transform:uppercase;opacity:.9;}\n  h1{margin:0;font-size:clamp(30px,8vw,46px);font-weight:800;letter-spacing:.02em;\n    background:linear-gradient(90deg,#9ff0fb,var(--teal));-webkit-background-clip:text;background-clip:text;color:transparent;\n    text-shadow:0 0 30px rgba(52,182,196,.25);}\n  .sub{margin:0;color:var(--mut);font-size:clamp(13px,3.6vw,15px);max-width:30ch;line-height:1.45;}\n  .score-line{color:var(--ink);font-size:16px;}\n  .score-line b{color:var(--cyan);font-size:22px;}\n  .btn{appearance:none;border:0;cursor:pointer;font:inherit;font-weight:700;letter-spacing:.06em;\n    color:#04171b;background:linear-gradient(180deg,var(--cyan),var(--teal));\n    padding:15px 26px;border-radius:12px;font-size:16px;min-width:210px;min-height:52px;\n    box-shadow:0 10px 24px rgba(52,182,196,.35),inset 0 1px 0 rgba(255,255,255,.4);\n    transition:transform .08s ease, filter .2s ease;}\n  .btn:active{transform:translateY(1px) scale(.99);filter:brightness(1.05);}\n  .hint{color:var(--mut);font-size:12px;letter-spacing:.04em;opacity:.8;}\n  /* In-play HUD */\n  #hud{position:absolute;top:14px;left:0;right:0;text-align:center;pointer-events:none;\n    font-variant-numeric:tabular-nums;font-weight:800;font-size:clamp(30px,8vw,44px);\n    color:#eaf7fb;text-shadow:0 2px 18px rgba(0,0,0,.55),0 0 24px rgba(52,182,196,.25);}\n  #hud.hide{display:none;}\n  .brandline{position:absolute;bottom:10px;left:0;right:0;text-align:center;color:rgba(159,176,189,.55);\n    font-size:11px;letter-spacing:.14em;pointer-events:none;text-transform:uppercase;}\n  .over h1{background:linear-gradient(90deg,#ff9a8f,var(--danger));-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 0 30px rgba(219,85,74,.25);}\n</style>\n</head>\n<body>\n<div id=\"wrap\">\n  <div id=\"stage\">\n    <canvas id=\"game\"></canvas>\n    <div id=\"hud\" class=\"hide\">0</div>\n\n    <div id=\"startScreen\" class=\"overlay\">\n      <div class=\"kicker\">StrataBI \u00b7 Extensibility Demo</div>\n      <h1>FLAPPY DATA</h1>\n      <p class=\"sub\">An entirely unnecessary demonstration of StrataBI extensibility.</p>\n      <button id=\"startBtn\" class=\"btn\">START PIPELINE</button>\n      <p class=\"hint\">Tap, click, or press Space to fly.</p>\n    </div>\n\n    <div id=\"overScreen\" class=\"overlay over hide\">\n      <div class=\"kicker\">status: failed</div>\n      <h1>PIPELINE FAILURE</h1>\n      <p class=\"score-line\">Score <b id=\"finalScore\">0</b></p>\n      <p class=\"score-line\">Best <b id=\"bestScore\">0</b></p>\n      <button id=\"retryBtn\" class=\"btn\">RETRY DEPLOYMENT</button>\n      <p class=\"hint\">Tap, click, or press Space to redeploy.</p>\n    </div>\n\n    <div class=\"brandline\">shaleio \u00b7 strata&shy;bi</div>\n  </div>\n</div>\n\n<script>\n(function(){\n  \"use strict\";\n\n  // ---- Shaleio logo (official asset, embedded as a data URI \u2014 no network) ----\n  var LOGO_SRC = \"data:image/png;base64,\";\n  var logo = new Image();\n  var logoReady = false;\n  logo.onload = function(){ logoReady = true; };\n  logo.src = LOGO_SRC;\n\n  // ---- Canvas + DPR ----\n  var stage = document.getElementById(\"stage\");\n  var canvas = document.getElementById(\"game\");\n  var ctx = canvas.getContext(\"2d\");\n  var hud = document.getElementById(\"hud\");\n  var W = 0, H = 0, DPR = 1;\n\n  function resize(){\n    DPR = Math.min(window.devicePixelRatio || 1, 2.5);\n    var r = stage.getBoundingClientRect();\n    W = Math.max(240, r.width); H = Math.max(320, r.height);\n    canvas.width = Math.round(W * DPR); canvas.height = Math.round(H * DPR);\n    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);\n    buildStars();\n  }\n  window.addEventListener(\"resize\", resize);\n\n  // ---- Background network field (cheap, precomputed) ----\n  var stars = [];\n  function buildStars(){\n    stars.length = 0;\n    var n = Math.round((W * H) / 26000); n = Math.max(14, Math.min(40, n));\n    for (var i=0;i<n;i++){\n      stars.push({ x:Math.random()*W, y:Math.random()*H,\n        r:1+Math.random()*2.2, s:6+Math.random()*16, p:Math.random()*Math.PI*2 });\n    }\n  }\n\n  // ---- Game state ----\n  var STATE = { START:0, PLAY:1, OVER:2 };\n  var state = STATE.START;\n  var score = 0, best = 0;         // best lives in memory for the session only\n  var running = true;              // paused when tile/tab not visible\n\n  // Player (sized relative to height for consistent feel across viewports)\n  var bird = { x:0, y:0, vy:0, size:0, aspect:1 };\n  // Obstacles: reused objects, no per-frame allocation in the loop\n  var obstacles = [];\n  var spawnTimer = 0;\n  var scale = 1;                   // world scale derived from height\n\n  function metrics(){\n    scale = H / 640;                       // reference height\n    bird.size = Math.max(26, 46 * scale);  // logo height in px\n    bird.aspect = (logoReady && logo.naturalWidth) ? (logo.naturalWidth / logo.naturalHeight) : 1.35;\n    bird.x = W * 0.30;\n  }\n\n  function reset(){\n    metrics();\n    bird.y = H * 0.44; bird.vy = 0;\n    obstacles.length = 0;\n    spawnTimer = 0; score = 0;\n    hud.textContent = \"0\";\n  }\n\n  // Tunables (per-second, delta-time integrated)\n  var GRAV = 1750;          // px/s^2\n  var FLAP = -470;          // px/s impulse\n  var MAXV = 820;\n\n  function speedFor(s){ return (152 + Math.min(s*4.2, 120)) * scale; }      // px/s, eases up with score\n  function gapFor(s){ return Math.max(150*scale, (232 - Math.min(s*2.4,86)) * scale); }\n  function spawnGap(){ return Math.max(230*scale, (W*0.62)); }               // horizontal spacing\n\n  function spawnObstacle(){\n    var gap = gapFor(score);\n    var margin = 70 * scale;\n    var gy = margin + gap/2 + Math.random() * Math.max(10, (H - gap - margin*2));\n    // reuse a recycled object if available\n    var o = null;\n    for (var i=0;i<obstacles.length;i++){ if (obstacles[i].dead){ o = obstacles[i]; break; } }\n    if (!o){ o = {}; obstacles.push(o); }\n    o.x = W + 40*scale; o.gapY = gy; o.gapH = gap; o.w = 64*scale; o.passed = false; o.dead = false;\n    // precompute node Y positions for each column so draw doesn't recompute every frame\n    o.nodesTop = []; o.nodesBot = [];\n    var step = 54 * scale;\n    for (var yy = gy - gap/2; yy > -step; yy -= step) o.nodesTop.push(yy);\n    for (var yb = gy + gap/2; yb < H + step; yb += step) o.nodesBot.push(yb);\n    o.seed = Math.random()*6.28;\n  }\n\n  function flap(){\n    if (state === STATE.PLAY){ bird.vy = FLAP; }\n  }\n\n  function start(){\n    reset(); state = STATE.PLAY;\n    document.getElementById(\"startScreen\").classList.add(\"hide\");\n    document.getElementById(\"overScreen\").classList.add(\"hide\");\n    hud.classList.remove(\"hide\");\n    bird.vy = FLAP * 0.6;\n  }\n\n  function gameOver(){\n    state = STATE.OVER;\n    if (score > best) best = score;\n    document.getElementById(\"finalScore\").textContent = String(score);\n    document.getElementById(\"bestScore\").textContent = String(best);\n    document.getElementById(\"overScreen\").classList.remove(\"hide\");\n    hud.classList.add(\"hide\");\n  }\n\n  // ---- Collision: circle (bird) vs the two solid node columns, leaving the gap clear ----\n  function hits(o){\n    var bx = bird.x, by = bird.y, br = bird.size*0.36;   // forgiving radius\n    if (bx + br < o.x || bx - br > o.x + o.w) return false;\n    if (by - br < o.gapY - o.gapH/2) return true;         // into the top column\n    if (by + br > o.gapY + o.gapH/2) return true;         // into the bottom column\n    return false;\n  }\n\n  // ---- Update ----\n  function update(dt){\n    // background drift\n    for (var i=0;i<stars.length;i++){\n      var st = stars[i]; st.x -= st.s*dt*0.35; if (st.x < -4){ st.x = W+4; st.y = Math.random()*H; }\n    }\n    if (state !== STATE.PLAY) return;\n\n    bird.vy += GRAV*dt; if (bird.vy > MAXV) bird.vy = MAXV;\n    bird.y += bird.vy*dt;\n\n    // floor / ceiling\n    if (bird.y + bird.size*0.36 >= H){ bird.y = H - bird.size*0.36; return gameOver(); }\n    if (bird.y - bird.size*0.36 < 0){ bird.y = bird.size*0.36; bird.vy = 0; }\n\n    var spd = speedFor(score);\n    spawnTimer -= spd*dt;\n    if (spawnTimer <= 0){ spawnObstacle(); spawnTimer = spawnGap(); }\n\n    for (var k=0;k<obstacles.length;k++){\n      var o = obstacles[k]; if (o.dead) continue;\n      o.x -= spd*dt;\n      if (!o.passed && (o.x + o.w) < bird.x){ o.passed = true; score++; hud.textContent = String(score); }\n      if (o.x + o.w < -60){ o.dead = true; continue; }\n      if (hits(o)) return gameOver();\n    }\n  }\n\n  // ---- Draw ----\n  function drawStars(){\n    ctx.save();\n    // faint connecting lines between near stars\n    ctx.strokeStyle = \"rgba(52,182,196,.08)\"; ctx.lineWidth = 1;\n    for (var i=0;i<stars.length;i++){\n      for (var j=i+1;j<stars.length;j++){\n        var a=stars[i], b=stars[j], dx=a.x-b.x, dy=a.y-b.y, d2=dx*dx+dy*dy;\n        if (d2 < 120*120){ ctx.globalAlpha = 1 - Math.sqrt(d2)/120; ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke(); }\n      }\n    }\n    ctx.globalAlpha = 1;\n    for (var s=0;s<stars.length;s++){\n      var st=stars[s]; ctx.beginPath(); ctx.fillStyle=\"rgba(95,224,239,.5)\";\n      ctx.arc(st.x, st.y, st.r, 0, 6.2832); ctx.fill();\n    }\n    ctx.restore();\n  }\n\n  function drawColumn(o, nodes, isTop){\n    var cx = o.x + o.w/2;\n    // glowing edge\n    ctx.strokeStyle = \"rgba(95,224,239,.55)\"; ctx.lineWidth = 2.5*scale; ctx.shadowColor=\"rgba(52,182,196,.8)\"; ctx.shadowBlur=10;\n    ctx.beginPath();\n    for (var i=0;i<nodes.length;i++){ if(i===0) ctx.moveTo(cx, nodes[i]); else ctx.lineTo(cx, nodes[i]); }\n    ctx.stroke(); ctx.shadowBlur=0;\n    // nodes\n    for (var n=0;n<nodes.length;n++){\n      var y=nodes[n], rad=11*scale;\n      var g=ctx.createRadialGradient(cx,y,1,cx,y,rad*1.6);\n      g.addColorStop(0,\"#9ff3ff\"); g.addColorStop(.45,\"#34b6c4\"); g.addColorStop(1,\"rgba(28,111,122,0)\");\n      ctx.fillStyle=g; ctx.beginPath(); ctx.arc(cx,y,rad*1.6,0,6.2832); ctx.fill();\n      ctx.fillStyle=\"#0c1a20\"; ctx.beginPath(); ctx.arc(cx,y,rad*0.5,0,6.2832); ctx.fill();\n      ctx.strokeStyle=\"#7fe6f2\"; ctx.lineWidth=1.6*scale; ctx.beginPath(); ctx.arc(cx,y,rad*0.5,0,6.2832); ctx.stroke();\n    }\n  }\n\n  function drawBird(){\n    ctx.save();\n    ctx.translate(bird.x, bird.y);\n    var ang = Math.max(-0.5, Math.min(0.9, bird.vy/900));\n    ctx.rotate(ang);\n    var h = bird.size, w = h * bird.aspect;\n    // soft glow behind the logo\n    ctx.shadowColor=\"rgba(52,182,196,.55)\"; ctx.shadowBlur=18;\n    if (logoReady){\n      ctx.drawImage(logo, -w/2, -h/2, w, h);\n    } else {\n      ctx.fillStyle=\"#34b6c4\"; ctx.beginPath(); ctx.arc(0,0,h/2,0,6.2832); ctx.fill();\n    }\n    ctx.restore();\n  }\n\n  function draw(){\n    ctx.clearRect(0,0,W,H);\n    drawStars();\n    for (var k=0;k<obstacles.length;k++){ var o=obstacles[k]; if(o.dead) continue; drawColumn(o,o.nodesTop,true); drawColumn(o,o.nodesBot,false); }\n    drawBird();\n  }\n\n  // ---- Main loop (delta-time, clamped) ----\n  var last = 0;\n  function frame(ts){\n    if (!running){ last = ts; requestAnimationFrame(frame); return; }\n    if (!last) last = ts;\n    var dt = (ts - last)/1000; last = ts;\n    if (dt > 0.05) dt = 0.05;           // clamp after a stall / tab switch\n    update(dt); draw();\n    requestAnimationFrame(frame);\n  }\n\n  // ---- Input ----\n  function press(e){\n    // Only swallow the event inside the playfield so the parent page scrolls normally elsewhere.\n    if (state === STATE.PLAY){ if(e && e.cancelable) e.preventDefault(); flap(); }\n    else if (state === STATE.START){ start(); }\n    else if (state === STATE.OVER){ start(); }\n  }\n  stage.addEventListener(\"pointerdown\", function(e){ press(e); }, {passive:false});\n  document.getElementById(\"startBtn\").addEventListener(\"click\", function(e){ e.stopPropagation(); start(); });\n  document.getElementById(\"retryBtn\").addEventListener(\"click\", function(e){ e.stopPropagation(); start(); });\n  window.addEventListener(\"keydown\", function(e){\n    if (e.code === \"Space\" || e.code === \"ArrowUp\" || e.key === \" \"){\n      e.preventDefault();\n      if (state === STATE.PLAY) flap(); else start();\n    }\n  }, {passive:false});\n\n  // ---- Pause when not visible (tab hidden or tile scrolled off-screen) ----\n  document.addEventListener(\"visibilitychange\", function(){ running = !document.hidden; last = 0; });\n  if (\"IntersectionObserver\" in window){\n    new IntersectionObserver(function(ents){\n      running = ents[0].isIntersecting && !document.hidden; last = 0;\n    }, {threshold:0.1}).observe(stage);\n  }\n\n  // ---- Boot ----\n  resize(); reset();\n  requestAnimationFrame(frame);\n})();\n</script>\n</body>\n</html>\n",
          "height": "min(760px, 88vh)"
        }
      }
    }
  ]
}